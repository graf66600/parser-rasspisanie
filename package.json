{
  "name": "schedule-parser-bot",
  "version": "1.0.0",
  "description": "Telegram-бот для парсинга расписания из Excel и напоминания о парах преподавателю (Трипольский)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test:parser": "tsx src/testParser.ts",
    "test:pdf": "tsx src/testPdfParser.ts",
    "test": "npm run test:client && npm run test:parser && npm run test:pdf",
    "test:client": "node --experimental-vm-modules --test tests/client-syntax.cjs tests/schedule-startup.cjs",
    "apply:schedule": "tsx src/scripts/applySchedule.ts"
  },
  "keywords": [
    "telegram",
    "telegraf",
    "schedule",
    "excel",
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.4",
    "telegraf": "^4.16.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
